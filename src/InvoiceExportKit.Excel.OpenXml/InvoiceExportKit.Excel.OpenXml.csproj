<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>InvoiceExportKit.Excel.OpenXml</PackageId>
    <Version>1.0.0</Version>
    <Authors>InvoiceExportKit Contributors</Authors>
    <Description>Open XML SDK-based Excel exporter for InvoiceExportKit</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InvoiceExportKit.Abstractions\InvoiceExportKit.Abstractions.csproj" />
    <ProjectReference Include="..\InvoiceExportKit.Templates\InvoiceExportKit.Templates.csproj" />
  </ItemGroup>
</Project>
