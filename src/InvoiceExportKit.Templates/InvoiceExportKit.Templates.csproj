<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>InvoiceExportKit.Templates</PackageId>
    <Version>1.0.0</Version>
    <Authors>Zdravko Lukic</Authors>
    <Description>Built-in invoice templates (Simple, Corporate) for InvoiceExportKit. Pluggable via IInvoiceTemplate.</Description>
    <PackageTags>invoice excel openxml export templates</PackageTags>
    <RepositoryUrl>https://github.com/zdrave08/invoice-export-kit</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InvoiceExportKit.Abstractions\InvoiceExportKit.Abstractions.csproj" />
  </ItemGroup>
</Project>
