<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>

    <PackageId>InvoiceExportKit.Abstractions</PackageId>
    <Version>1.0.2</Version>
    <Authors>Zdravko Lukic</Authors>

    <Description>Core contracts, models, and options for InvoiceExportKit. Shared abstractions with no rendering dependencies.</Description>
    <PackageTags>invoice excel export openxml abstractions models contracts</PackageTags>

    <PackageProjectUrl>https://github.com/zdrave08/InvoiceExportKit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/zdrave08/InvoiceExportKit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
